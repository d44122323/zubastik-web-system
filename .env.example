# Local PostgreSQL (Railway provides DATABASE_URL automatically)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=clinic
DB_SSLMODE=disable

# Production can use DATABASE_URL instead of DB_* variables.
# DATABASE_URL=postgresql://...

APP_ENV=development
PORT=8080

OPENROUTER_API_KEY=

TELEGRAM_PATIENT_BOT_TOKEN=
TELEGRAM_PATIENT_BOT_USERNAME=

TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_CHAT_ID=

# Public production URL, e.g. https://your-domain.com
SITE_URL=http://localhost:8080

# Local default is ../uploads. Railway Volume should use /app/uploads.
# UPLOADS_DIR=/app/uploads

EMAIL_USER=
EMAIL_PASSWORD=
BITRIX_WEBHOOK=
