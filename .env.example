# Production database connection. Railway provides DATABASE_URL from PostgreSQL.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

APP_ENV=production
PORT=

OPENROUTER_API_KEY=

TELEGRAM_PATIENT_BOT_TOKEN=
TELEGRAM_PATIENT_BOT_USERNAME=

TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_STAFF_BOT_USERNAME=
TELEGRAM_STAFF_CHAT_ID=

# Public production URL, e.g. https://your-domain.com
SITE_URL=

# Railway Volume should be mounted at /app/uploads.
UPLOADS_DIR=/app/uploads

EMAIL_USER=
EMAIL_PASSWORD=
BITRIX_WEBHOOK=

# Optional: create the first admin account in a fresh database.
ADMIN_LOGIN=
ADMIN_PASSWORD=
